APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8888
APP_TIMEZONE=Asia/Kolkata

# PostgreSQL 16 Database Configuration
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=infusetax_db
DB_USERNAME=infusetax_user
DB_PASSWORD=infusetax_secure_password

# Redis 7 Cache & Queue Broker
REDIS_HOST=redis
REDIS_PORT=6379

# Cloudflare R2 Zero-Egress Storage
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=infusetax-vault

# DLT SMS Gateway Configuration
DLT_SMS_SENDER_ID=INFUST
DLT_SMS_API_KEY=

# NPCI UPI Top-Up Configuration
UPI_PAYEE_VPA=infusetax.retail@icici
UPI_PAYEE_NAME=InfuseTax Technologies Pvt Ltd

# Government API Sandboxes (GSTN / Protean NSDL)
GOVT_GSTN_CLIENT_ID=
GOVT_PROTEAN_API_KEY=

# WhatsApp Business Communication Gateway (Meta Cloud API / Webhook / Twilio)
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=meta
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_API_TOKEN=EAAG_infusetax_meta_cloud_api_token_sample_2026
WHATSAPP_PHONE_NUMBER_ID=109283746592019
WHATSAPP_BUSINESS_ACCOUNT_ID=987123654098
WHATSAPP_DEFAULT_SENDER=+919876543210
WHATSAPP_COMMON_ADMIN_NUMBER=9944072249
WHATSAPP_NOTIFY_ON_WALLET_APPLY=true
WHATSAPP_NOTIFY_ON_WALLET_APPROVE=true
WHATSAPP_NOTIFY_ON_SERVICE_APPROVE=true
