{
    "name": "infusetax/backend",
    "description": "InfuseTax Enterprise REST API with Laravel Eloquent ORM",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "illuminate/database": "^11.0",
        "illuminate/events": "^11.0",
        "psr/container": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}