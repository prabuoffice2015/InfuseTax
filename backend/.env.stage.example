APP_ENV=staging
APP_DEBUG=true
APP_URL=http://stage.taxpartner.in:8081
APP_TIMEZONE=Asia/Kolkata

# PostgreSQL 16 Staging Database Configuration
DB_CONNECTION=pgsql
DB_HOST=postgres_stage
DB_PORT=5432
DB_DATABASE=infusetax_stage_db
DB_USERNAME=infusetax_user
DB_PASSWORD=infusetax_secure_password

# Redis 7 Staging Cache & Queue Broker
REDIS_HOST=redis_stage
REDIS_PORT=6379

# Cloudflare R2 Zero-Egress Storage
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=infusetax-vault-staging

# DLT SMS Gateway Configuration
DLT_SMS_SENDER_ID=INFUST
DLT_SMS_API_KEY=

# NPCI UPI Top-Up Configuration
UPI_PAYEE_VPA=infusetax.retail@icici
UPI_PAYEE_NAME=InfuseTax Technologies Pvt Ltd (Staging)

# Government API Sandboxes (GSTN / Protean NSDL)
GOVT_GSTN_CLIENT_ID=
GOVT_PROTEAN_API_KEY=

# WhatsApp Business Communication Gateway
WHATSAPP_ENABLED=false
