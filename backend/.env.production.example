# InfuseTax Production Environment Configuration ($0/mo Free Tier)

APP_NAME="InfuseTax"
APP_ENV=production
APP_KEY=base64:INFUSETAX_PROD_SECRET_KEY_REPLACE_ME_1234
APP_DEBUG=false
APP_URL=https://api.yourdomain.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# 1. Managed PostgreSQL 16 (Supabase / Neon.tech - 100% Free)
DB_CONNECTION=pgsql
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=your_supabase_strong_password
DB_SSLMODE=require

# 2. Serverless Redis (Upstash Redis - 100% Free)
REDIS_HOST=eu1-strong-redis-xxxxx.upstash.io
REDIS_PASSWORD=your_upstash_token
REDIS_PORT=6379
REDIS_CLIENT=phpredis

# 3. Document Vault (Cloudflare R2 - 10GB Free, $0 Egress)
AWS_ACCESS_KEY_ID=your_cloudflare_r2_access_key
AWS_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_key
AWS_DEFAULT_REGION=auto
AWS_BUCKET=infusetax-documents
AWS_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=true

# 4. Cache & Sessions
BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=r2
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
